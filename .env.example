DATABASE_URL=sqlite:///./xray.db
ENVIRONMENT=development
DEBUG=false
# PostgreSQL: postgresql+psycopg://xray:xray@db:5432/xray
MAX_UPLOAD_MB=20
MIN_IMAGE_DIMENSION=32
MAX_IMAGE_DIMENSION=12000
AUTO_CLASSIFY_MIN_CONFIDENCE=0.70
UNCERTAINTY_MARGIN=0.12
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:5173
DUMMY_MODE=true
MODEL_VERSION=dummy-v1
CODE_VERSION=0.3.0
RETENTION_DAYS=
LOG_LEVEL=INFO
LLM_PROVIDER=dummy
LLM_MODEL=deterministic-agent-v1
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL_NAME=Qwen2.5-7B-Instruct
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=1
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=xray_knowledge
QDRANT_VECTOR_SIZE=384
EMBEDDING_PROVIDER=deterministic-local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=8
RETRIEVAL_FINAL_K=5
RRF_K=60
# 개발 호환 모드. 운영에서는 ENFORCED=true, LEGACY/DEMO=false와 32자 이상 무작위 secret을 사용합니다.
AUTH_ENFORCED=false
AUTH_ALLOW_LEGACY_HEADERS=true
AUTH_DEMO_TOKENS_ENABLED=true
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=900
AUTH_PUBLIC_PATHS=/api/health,/api/model/info,/api/classes,/docs,/openapi.json,/redoc
AGENT_MAX_STEPS=12
AGENT_TIMEOUT_SECONDS=15
AGENT_RETENTION_DAYS=30
AGENT_DAILY_COST_LIMIT_USD=0
VITE_API_URL=http://localhost:8000
PACS_PROVIDER=none
PACS_ENABLED=false
ORTHANC_BASE_URL=
ORTHANC_USERNAME=
ORTHANC_PASSWORD=
ORTHANC_TIMEOUT_SECONDS=10
ORTHANC_VERIFY_TLS=true
DICOMWEB_BASE_URL=
DICOMWEB_QIDO_PATH=/studies
DICOMWEB_WADO_PATH=/studies
DICOMWEB_STOW_PATH=/studies
DICOMWEB_TOKEN=
DICOMWEB_TIMEOUT_SECONDS=15
DICOMWEB_VERIFY_TLS=true
FHIR_ENABLED=false
FHIR_BASE_URL=
FHIR_TOKEN=
FHIR_TIMEOUT_SECONDS=15
FHIR_VERIFY_TLS=true
EXTERNAL_TRANSMISSION_ENABLED=false
EXTERNAL_TRANSMISSION_ALLOW_DEMO=false
EXTERNAL_MAX_RETRIES=3
EXTERNAL_RETRY_BASE_SECONDS=2
INTEGRATION_STORE_RAW_UIDS=false
INTEGRATION_AUDIT_ENABLED=true
INTEGRATION_PRINCIPAL_INSTITUTIONS={}
INTEGRATION_RESOURCE_INSTITUTIONS={}
INTEGRATION_CONNECTION_INSTITUTION_ID=
QMS_SLLM_ENABLED=false
QMS_RISK_HIGH_SCORE=10
QMS_RISK_CRITICAL_SCORE=20
